# MQTT broker reachable from this VPS
MQTT_HOST=192.168.1.10
MQTT_PORT=1883
MQTT_USERNAME=vps-monitor
MQTT_PASSWORD=change-me
# Set to true when the broker uses TLS.
MQTT_TLS=false
# Optional CA bundle; leave empty to use the OS trust store.
MQTT_CA_FILE=

# Stable ID: lowercase letters, digits, underscore or hyphen.
VPS_ID=my_vps
VPS_NAME=My VPS
PUBLISH_INTERVAL=15
HEALTH_CHECK_INTERVAL=300
UPDATE_CHECK_INTERVAL=86400
MONITOR_NETWORK=false
DISCOVERY_PREFIX=homeassistant

# Alert thresholds
CPU_WARN_PERCENT=90
MEMORY_WARN_PERCENT=90
DISK_WARN_PERCENT=85
# Number of consecutive samples before CPU/RAM overload is raised.
OVERLOAD_SAMPLES=20

# Space-separated systemd unit names. Empty is allowed.
WATCH_SERVICES=ssh
