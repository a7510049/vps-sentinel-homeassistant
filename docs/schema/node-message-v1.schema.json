{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/a7510049/vps-sentinel-homeassistant/blob/main/docs/schema/node-message-v1.schema.json",
  "title": "VPS Sentinel node message v1",
  "description": "Cross-language message envelope published by a VPS Sentinel Agent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "message_type",
    "node",
    "observed_at",
    "sequence",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "message_type": {
      "enum": [
        "availability",
        "event",
        "health",
        "metadata",
        "resources"
      ]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "display_name",
        "agent_version",
        "capabilities",
        "labels"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "agent_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "capabilities": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
          }
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "labels": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        }
      }
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "data": {
      "type": "object"
    }
  }
}
